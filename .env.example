# Copy this file to .env and fill in real values.

# Free tier: https://dashboard.api-football.com/register
API_FOOTBALL_KEY=your_key_here

# Free tier: https://www.football-data.org/client/register (TIER_ONE covers Champions League)
FOOTBALL_DATA_ORG_TOKEN=your_token_here

# Free tier: https://bigballsdata.com/dashboard (2000/day with GitHub link, 100/min).
# Lineups + per-match player stats — covers EPL/La Liga/Bundesliga/Serie A/Ligue 1 only,
# current season + 1 prior. See ingest/bigballs.py.
BIGBALLS_API_KEY=your_key_here

# Free tier: https://highlightly.net or https://rapidapi.com (100/day, no card).
# Lineups only, Champions League + Europa League — the two competitions
# bigballsdata.com doesn't cover at all. See ingest/highlightly.py.
HIGHLIGHTLY_API_KEY=your_key_here

# Hard daily cap this app will refuse to exceed (API-Football free tier = 100/day).
# Set below the true plan limit to leave headroom for manual debugging calls.
API_FOOTBALL_DAILY_CAP=90

# SQLite path (relative to project root). Swap to a Postgres URL when deploying.
DATABASE_URL=sqlite:///data/app.db

# Hours after which the UI shows a "data is stale" warning.
STALE_AFTER_HOURS=36
